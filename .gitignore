# ==========================================
# DATA FILES (Настройка папок)
# ==========================================

# 1. DOCUMENTS
# Игнорируем всё внутри documents...
data/documents/*
# ...НО оставляем файл .gitkeep (чтобы папка осталась в репозитории)
!data/documents/.gitkeep

# 2. QUESTIONS
# Игнорируем все сгенерированные вопросы...
data/questions/*
# ...НО оставляем .gitkeep
!data/questions/.gitkeep

# 3. REPORTS
# Игнорируем отчеты...
data/reports/*
# ...НО оставляем .gitkeep
!data/reports/.gitkeep

# 4. TESTSETS (Старые настройки)
data/testsets/*_extracted_*.jsonl
data/testsets/questions_*.jsonl
# Если хотите игнорировать папку целиком, но оставить примеры:
# data/testsets/*
# !data/testsets/example_*.jsonl
